# LLM provider for the buyer agent: "openai" (default) or "openrouter"
BUYER_MODEL_PROVIDER=openai

# Required when BUYER_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Required when BUYER_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
# Optional: override the OpenRouter base URL (e.g. for a proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model for the buyer agent — defaults to gpt-5-mini for openai, openai/gpt-5-mini for openrouter
BUYER_MODEL=gpt-5-mini

# URL of the Sales Agent Harness (running in Docker on port 3000)
SELLER_URL=http://localhost:3000

# Port for this buyer agent demo server (default: 3001)
PORT=3001

# Buyer identity used to complete checkout and place the order (all optional)
BUYER_EMAIL=buyer@example.com
BUYER_FIRST_NAME=Alex
BUYER_LAST_NAME=Demo
BUYER_STREET=Ebbinghoff 10
BUYER_ZIPCODE=48624
BUYER_CITY=Schöppingen
BUYER_COUNTRY=DE

# Wallet private key (hex, 0x-prefixed) the buyer agent signs x402 payments
# with. Required only to settle payment when the seller returns x402
# instructions on a completed checkout; leave unset to see checkout complete
# without payment settling. Use a funded test wallet only (e.g. base-sepolia).
PAYER_PK=

# AP2 checkout/payment mandates are generated and signed automatically with
# an ephemeral in-process keypair — no configuration needed. This is a demo
# simplification (plain ES256 JWTs, not full SD-JWT+kb selective disclosure)
# to exercise the harness's mandate-relay plumbing; it does not guarantee the
# shop's payment processor will recognize or trust the signature.
